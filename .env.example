# API (apps/server). Run `bun run db:migrate` against DATABASE_URL before the first start.
CHAIN_ID=84532
# Comma-separated JSON-RPC endpoints, tried in order (use two providers for failover).
RPC_URL=https://sepolia.base.org
EXCHANGE_ADDRESS=0x0000000000000000000000000000000000000000
DEPLOYMENT_BLOCK=0
# Only for an RPC without the `finalized` block tag: blocks behind head treated as final.
# FINALITY_DEPTH=64
# Head polling follows the chain's block time, learned from headers. Set only to fix the interval.
# POLL_MS=2000
DATABASE_URL=postgresql://probabl:replace-password@127.0.0.1:5432/probabl
API_HOST=127.0.0.1
API_PORT=3000
# Comma-separated browser origins allowed to sign in (trading UI and admin). A trading UI on the
# API's site (app.example.com with api.example.com) keeps sessions in HttpOnly cookies; one on
# another site (a local UI against this API) keeps bearer tokens in browser storage instead.
API_AUTH_ORIGINS=https://app.example.com,https://admin.example.com
# Proxies in front of the API that set X-Forwarded-For (1 behind ops/ec2's nginx): sign-in and
# invite rate limits key on the client address. Local plain-HTTP development alone sets
# SESSION_COOKIE_INSECURE=1 (browsers keep `__Host-`/Secure cookies for HTTPS only).
TRUST_PROXY_HOPS=1
# Invite-only access: codes each member may create (the admin changes it per member).
INVITE_CODES_PER_MEMBER=5
# Referral program: share of a referee's net fees (bps) and for how long after it joins.
REFERRAL_SHARE_BPS=1500
REFERRAL_MONTHS=6
LOG_LEVEL=info
REDIS_URL=redis://127.0.0.1:6379
EVIDENCE_PUBLIC_BASE_URL=https://api.example.com/v1/attachments
ROBINHOOD_PRICES_URL=https://api.robinhood.com/rhj
# Service key that submits orders for wallets that approved one-click trading.
TRADING_DELEGATE_ADDRESS=
TRADING_DELEGATE_PRIVATE_KEY=
# RFQ (docs/rfq.md; needs the trading key): how long a market order waits for quotes from the
# approved makers online, the least lifetime a signed quote must have left when it arrives, and
# live connections per maker API key.
RFQ_QUOTE_WINDOW_MS=500
RFQ_MIN_QUOTE_SECONDS=3
RFQ_CONNECTIONS_PER_KEY=2
# Testnets only: a wallet that pays the gas of minting each member's test tokens once (the quote,
# every listed token and FAUCET_TOKENS, comma-separated testnet tokens anyone can mint).
# FAUCET_GAS_ETH also sends that much ETH per claim (default none). Set directly on the host.
FAUCET_PRIVATE_KEY=
FAUCET_TOKENS=
FAUCET_GAS_ETH=
# Dedicated wallet that pays claimed referral rewards (gas plus the reward tokens, topped up by
# scripts/evm/fund-referrals.ts). Unset leaves claims off. Set directly on the backend host.
REFERRAL_PAYOUT_PRIVATE_KEY=
# Comma-separated Δ-vault addresses the API describes (docs/delta-vault.md). The trading UI and
# admin pin their own list in NEXT_PUBLIC_DELTA_VAULTS: the API never chooses where funds go.
DELTA_VAULT_ADDRESSES=

# Polymarket ingestor (services/polymarket-ingestor); the API reads it with the same token.
POLYMARKET_INGESTOR_URL=http://127.0.0.1:42073
POLYMARKET_INTERNAL_TOKEN=replace-with-a-long-random-service-token
POLYMARKET_HOST=127.0.0.1
POLYMARKET_PORT=42073
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_RECONCILE_MS=30000
POLYMARKET_METADATA_POLL_MS=300000
POLYMARKET_STALE_AFTER_MS=90000
# 100 USDC at six decimals.
POLYMARKET_STANDARD_NOTIONAL_X6=100000000
# Kalshi, in the same ingestor (public REST API, polled: books every 5 s, metadata every minute).
KALSHI_API_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_BOOK_POLL_MS=5000
KALSHI_METADATA_POLL_MS=60000

# Market automation (services/market-automation, docs/market-automation.md). Its keys belong in
# .env.market-automation on the backend host, which makes PM2 run it with --execute. Without
# RESOLUTION_ADMIN_PRIVATE_KEY, markets stop at their resolution commitment unless both roles are
# the same wallet.
MARKET_ADMIN_PRIVATE_KEY=
RESOLUTION_ADMIN_PRIVATE_KEY=
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
AUTOMATION_API_URL=http://127.0.0.1:3000
# A sign-in origin listed in API_AUTH_ORIGINS.
AUTOMATION_AUTH_ORIGIN=https://admin.example.com
# Δ-vaults whose new markets the automation registers (services/market-automation/vaults.example.json),
# signed by CURATOR_PRIVATE_KEY, or by the market admin when it is also the curator.
AUTOMATION_VAULTS_PATH=.local/market-automation/vaults.json
CURATOR_PRIVATE_KEY=
# Daily and weekly ladders of markets on Kalshi strikes (services/market-automation/ladders.example.json,
# the Robinhood testnet slate); their strikes are read from KALSHI_API_URL.
AUTOMATION_LADDERS_PATH=.local/market-automation/ladders.json
