{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://probabl.trade/schemas/deployment-manifest-atomic-v2.json",
  "title": "probabl raw-unit v2 / checked atomic execution v2 deployment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chainId",
    "protocolVersion",
    "executionVersion",
    "priceFormat",
    "compiler",
    "deployer",
    "source",
    "productionApproved",
    "releaseBlockers",
    "configurationReceipts",
    "deployedAtBlock",
    "deployments",
    "roles",
    "usdg"
  ],
  "properties": {
    "protocolVersion": { "const": 2 },
    "executionVersion": { "const": 2 },
    "priceFormat": { "const": "raw-unit-ratio-x18" },
    "release": { "type": "object" },
    "chainId": { "type": "integer", "minimum": 1 },
    "deployer": { "$ref": "#/$defs/address" },
    "productionApproved": { "const": false },
    "releaseBlockers": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "source": {
      "type": "object",
      "required": ["algorithm", "digest", "files", "lockSha256"],
      "properties": {
        "algorithm": { "type": "string" },
        "digest": { "$ref": "#/$defs/sha256" },
        "lockSha256": { "$ref": "#/$defs/sha256" },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "sha256"],
            "properties": { "path": { "type": "string" }, "sha256": { "$ref": "#/$defs/sha256" } }
          }
        }
      }
    },
    "configurationReceipts": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["label", "transactionHash", "blockNumber", "blockHash"],
        "properties": {
          "label": { "type": "string" },
          "transactionHash": { "$ref": "#/$defs/hash" },
          "blockNumber": { "type": "string", "pattern": "^[0-9]+$" },
          "blockHash": { "$ref": "#/$defs/hash" }
        }
      }
    },
    "compiler": {
      "type": "object",
      "required": ["solc", "evmVersion", "optimizerRuns", "viaIr", "bytecodeHash"]
    },
    "deployedAtBlock": { "type": "string", "pattern": "^[0-9]+$" },
    "deployments": {
      "type": "object",
      "required": [
        "ConditionalTokens",
        "ProtocolAuthority",
        "MarketRegistry",
        "ManualResolutionController",
        "ConditionalExchange",
        "PayoutVault",
        "OrderValidator",
        "ConditionalSettlement",
        "ProtocolFeeVault",
        "AtomicOrderRouter",
        "PositionRouter",
        "OrderRecoveryRouter"
      ],
      "additionalProperties": {
        "type": "object",
        "required": ["address", "bytecodeHash"],
        "properties": {
          "address": { "$ref": "#/$defs/address" },
          "creator": { "$ref": "#/$defs/address" },
          "blockNumber": { "type": "string", "pattern": "^[0-9]+$" },
          "bytecodeHash": { "$ref": "#/$defs/hash" },
          "transactionHash": { "$ref": "#/$defs/hash" },
          "blockHash": { "$ref": "#/$defs/hash" },
          "constructorArgs": { "type": "array" },
          "initcodeHash": { "$ref": "#/$defs/hash" }
        }
      }
    },
    "roles": {
      "type": "object",
      "required": ["marketAdmin", "guardian", "resolutionAdmin", "finalDefaultAdmin"],
      "properties": {
        "marketAdmin": { "$ref": "#/$defs/address" },
        "guardian": { "$ref": "#/$defs/address" },
        "resolutionAdmin": { "$ref": "#/$defs/address" },
        "finalDefaultAdmin": { "$ref": "#/$defs/address" }
      }
    },
    "rpcUrl": { "const": "redacted" },
    "usdg": { "$ref": "#/$defs/address" }
  },
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "hash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
