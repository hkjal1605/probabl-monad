API_URL=http://127.0.0.1:3000
# Public build-time setting; never put logging credentials in NEXT_PUBLIC_*.
NEXT_PUBLIC_LOG_LEVEL=info
INDEXER_URL=http://127.0.0.1:42069
NEXT_PUBLIC_ROBINHOOD_CHAIN_ID=31337
NEXT_PUBLIC_ROBINHOOD_CHAIN_NAME=Robinhood Chain Local
NEXT_PUBLIC_ROBINHOOD_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_BLOCK_EXPLORER_URL=
NEXT_PUBLIC_CONDITIONAL_TOKENS_ADDRESS=
NEXT_PUBLIC_EXCHANGE_ADDRESS=
# Demo mode is selected explicitly in the UI and needs no backend/wallet configuration.
# NEXT_PUBLIC_ENABLE_PREVIEW_DATA is obsolete; live mode never falls back to dummy data.
NEXT_PUBLIC_POLYMARKET_STREAM_URL=ws://127.0.0.1:42073
