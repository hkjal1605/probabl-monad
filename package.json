{
  "name": "conditional-stocks",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "contracts",
    "packages/domain",
    "packages/shared",
    "packages/market-data",
    "packages/evm-client",
    "packages/database",
    "packages/operator",
    "services/indexer",
    "apps/server",
    "services/market-maker",
    "services/vault-keeper",
    "apps/web",
    "services/polymarket-ingestor",
    "apps/admin",
    "apps/docs",
    "scripts/evm"
  ],
  "scripts": {
    "abi": "bun packages/evm-client/scripts/abi.ts",
    "anvil:bootstrap": "bun scripts/evm/bootstrap.ts",
    "audit:deps": "bun audit",
    "build": "forge build --root contracts && bun run --workspaces --if-present build",
    "build:admin-ui": "bun --filter @conditional-stocks/admin-ui build",
    "build:contracts": "forge build --root contracts --sizes --skip test",
    "build:docs": "bun --filter @conditional-stocks/docs build",
    "build:ui": "bun --filter @conditional-stocks/web build",
    "build:ui:cloudflare": "bun --filter @conditional-stocks/web build:cloudflare",
    "check": "biome ci . && forge fmt --root contracts --check && forge lint --root contracts && forge build --root contracts --no-cache && bun run typecheck && bun run test",
    "create:markets": "bun scripts/evm/create-markets.ts",
    "db:migrate": "bun --filter @conditional-stocks/db migrate",
    "deploy:exchange": "bun scripts/evm/deploy.ts",
    "deploy:mock-feeds": "bun scripts/evm/deploy-mock-feeds.ts",
    "deploy:mock-usdg": "bun scripts/evm/deploy-mock-usdg.ts",
    "deploy:ui:cloudflare": "bun --filter @conditional-stocks/web deploy:cloudflare",
    "deploy:ui:cloudflare:strict": "bun --filter @conditional-stocks/web deploy:cloudflare:strict",
    "deploy:vault": "bun scripts/evm/deploy-vault.ts",
    "dev": "bun --env-file=.local/anvil.env scripts/evm/dev.ts",
    "dev:admin-ui": "bun --filter @conditional-stocks/admin-ui dev",
    "dev:api": "bun --filter @conditional-stocks/api dev",
    "dev:docs": "bun --filter @conditional-stocks/docs dev",
    "dev:polymarket": "bun --filter @conditional-stocks/polymarket-ingestor start",
    "dev:ui": "bun --filter @conditional-stocks/web dev",
    "format": "biome check --write . && forge fmt --root contracts",
    "lint": "biome lint . && forge lint --root contracts",
    "preview:ui:cloudflare": "bun --filter @conditional-stocks/web preview:cloudflare",
    "provision:vaults": "bun scripts/evm/provision-vaults.ts",
    "seed:markets": "bun --no-env-file --env-file=.local/anvil.env scripts/evm/seed-markets.ts",
    "start:admin-ui": "bun --filter @conditional-stocks/admin-ui start",
    "start:api": "bun --filter @conditional-stocks/api start",
    "start:docs": "bun --filter @conditional-stocks/docs start",
    "start:feed-mirror": "bun scripts/evm/feed-mirror.ts",
    "start:market-maker": "bun --filter @conditional-stocks/market-maker start",
    "start:polymarket": "bun --filter @conditional-stocks/polymarket-ingestor start",
    "start:ui": "bun --filter @conditional-stocks/web start",
    "start:vault-keeper": "bun --filter @conditional-stocks/vault-keeper start",
    "test": "bun run test:contracts && bun run test:ts",
    "test:contracts": "forge test --root contracts",
    "test:gas": "forge test --root contracts --match-contract Gas --gas-report",
    "test:ts": "bun scripts/evm/with-database.ts bun test packages/domain/src packages/shared/tests packages/market-data/tests packages/evm-client/test packages/operator/test services/indexer/test services/market-maker/test services/vault-keeper/test services/polymarket-ingestor/tests apps/server/test apps/web/test apps/admin/test",
    "typecheck": "bun run --workspaces --if-present typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/bun": "1.4.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "sharp": "^0.35.4",
    "undici": "^7.29.1"
  }
}
